HONEYCOMB_BIND=127.0.0.1:8080
HONEYCOMB_DATABASE=data/honeycomb.db
HONEYCOMB_APP_ID="tos>honeycomb"
HONEYCOMB_APP_SECRET=
# Generate with: openssl rand -hex 32
HONEYCOMB_ENCRYPTION_KEY=
HONEYCOMB_WEBHOOK_SECRET=
IAM_BASE_URL=https://backend.iam.teamofsilicons.com
IAM_LOGIN_URL=https://iam.teamofsilicons.com
BRIEFCASE_BASE_URL=https://backend.briefcase.teamofsilicons.com
# Managed AWS deployment provisions this shared lifecycle credential automatically.
# No per-app or per-environment token setup is required.
# Requires IAM_HONEYCOMB_SERVICE_CREDENTIAL to enable the management adapter.
BRIEFCASE_HONEYCOMB_SERVICE_TOKEN=
HONEYCOMB_WEB_ORIGINS=https://honeycomb.teamofsilicons.com,https://console.honeycomb.teamofsilicons.com
RUST_LOG=info

# Optional: queued production mail remains pending until configured. Test mail is captured.
POSTMARK_SERVER_TOKEN=

# IAM 1.10 protected management, provisioned independently of the app secret.
IAM_HONEYCOMB_SERVICE_CREDENTIAL=
# Separate service notification HMAC, receiver /management/webhook/
IAM_HONEYCOMB_NOTIFICATION_SIGNING_KEY=

# Optional diagnostics. Only the backend holds the dedicated tos/siliconhoneycomb table key.
HONEYCOMB_TELEMETRY=true
HONEYCOMB_SPACE_STATION_TABLE_KEY=
HONEYCOMB_TELEMETRY_HOME=data/telemetry
HONEYCOMB_TELEMETRY_URL=https://backend.spacestation.teamofsilicons.com
