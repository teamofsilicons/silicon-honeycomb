{
  "name": "@teamofsilicons/honeycomb-web",
  "version": "0.4.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --target=node24 --outfile=dist-server/index.js",
    "build:vercel": "tsc --noEmit && vite build && node scripts/build-vercel.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist-server/index.js",
    "test:e2e": "playwright test",
    "test:unit": "node --import tsx --test src/sent-requests.test.ts server/sessions.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "express": "5.2.1",
    "lucide-solid": "1.45.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14"
  },
  "engines": {
    "node": ">=24"
  }
}
